{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "rootDir": "../..",
    "composite": false
  },
  "include": [
    "../../tests/app/**/*.ts",
    "../../src/app/**/*.ts",
    "../../src/types/**/*.ts",
    "../../src/config/**/*.ts"
  ]
}
